                              <td align="center" class="tour1"><strong></strong>SRILANKA TOUR-II<br></td>
                              <td align="center" valign="top"><a href="javascript:history.go(-1)" class="menu1">BACK</a></td>
                            </tr>
                            <tr>
                              <td width="90%" align="center" class="tour1"><span class="menu">Duration: 03 Nights/04 Days<br>
                                Destination: Colombo-Kandy-Beruwela<br>
                              </span></td>
                              <td width="10%" align="center" valign="top">&nbsp;</td>

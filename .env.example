# Public core API origin for announcements, contact and tour enquiries; falls back to the quote API origin.
NEXT_PUBLIC_CORE_API_BASE_URL=https://api.example.com

# Public quote API origin only, without /api/v1/core. Backend must allow this site's origin for POST requests.
NEXT_PUBLIC_QUOTE_API_BASE_URL=https://api.example.com
# sandbox or production
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Customer API origin (or origin ending /api/v1); falls back to quote API origin.
NEXT_PUBLIC_CUSTOMER_API_BASE_URL=https://api.example.com

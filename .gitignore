# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output/

# next.js
/.next/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.p12
*.pfx
*.bak
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# deployment and local platform state
.vercel
/.wrangler/
/.dev.vars
/.dev.vars.*

# typescript
next-env.d.ts
*.tsbuildinfo

# build output and temporary work
/dist/
/outputs/
/work/
/.cache/
/tmp/
/temp/

# IDE and local tooling
/.idea/
/.vscode/
/.fleet/

# internal planning, research, prompts, and source-processing artifacts
/PRODUCT.md
/MEDIA_SOURCING.md
/research/
/scripts/
*.py[cod]

# local content-source archive; runtime data stays versioned
/content-bank/curated-assets/
/content-bank/itineraries/
/content-bank/legacy-assets/
/content-bank/legacy-html/
/content-bank/pages/
/content-bank/tour-pages/
